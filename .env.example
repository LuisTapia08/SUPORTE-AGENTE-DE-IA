# Copie este arquivo para .env e ajuste se precisar.
# Endereço do Ollama (padrão do instalador)
OLLAMA_URL=http://localhost:11434
# Modelo a usar (veja os instalados com: ollama list). Deixe vazio para escolher ao iniciar.
LLM_MODEL=
# Tempo máximo de espera por resposta, em segundos
LLM_TIMEOUT=180
# Raciocínio "thinking" de modelos como qwen3 (deixe false: fica mais rápido e o JSON sai limpo)
LLM_THINK=false
# Quanto tempo o Ollama mantém o modelo carregado depois do último uso
LLM_KEEP_ALIVE=30m
